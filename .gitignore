# Real per-server DB credentials / base_url live only on each server now,
# never in git, so a pull can never overwrite live settings. Copy
# app/config.example.php to app/config.php on each environment and fill
# it in once. app/config.local.php (see app_config() in app/helpers.php)
# is still supported as an optional override on top of config.php.
app/config.php
app/config.local.php

